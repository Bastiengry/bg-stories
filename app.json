{
  "expo": {
    "name": "BG Stories",
    "slug": "bg-stories",
    "version": "1.1.0",
    "orientation": "portrait",
    "scheme": "bgstories",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "splash": {
      "resizeMode": "contain",
      "backgroundColor": "#101018"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.bastiengry.bgstories",
      "infoPlist": {
        "NSSpeechRecognitionUsageDescription": "Detection de la voix du lecteur pour cette application de lecture d'histoires.",
        "NSMicrophoneUsageDescription": "Detection de la voix du lecteur pour cette application de lecture d'histoires."
      }
    },
    "android": {
      "package": "com.bastiengry.bgstories",
      "versionCode": 2,
      "edgeToEdgeEnabled": true
    },
    "plugins": [
      "expo-secure-store"
    ],
    "extra": {
      "eas": {
        "projectId": "6ed9dee2-4c41-4f7d-91fb-f5ff8289e49e"
      }
    },
    "owner": "bg_hr68"
  }
}
